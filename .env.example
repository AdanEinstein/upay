APP_NAME=Upay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Supabase Storage (S3 API), production only. Setting the buckets switches the
# 'public'/'local' disks from local files to Supabase (config/filesystems.php).
SUPABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_PUBLIC_BUCKET=
SUPABASE_PRIVATE_BUCKET=

VITE_APP_NAME="${APP_NAME}"

# Independent from APP_KEY so rotating one doesn't affect the other.
# Generate with: php -r 'echo base64_encode(random_bytes(32));'
PASSKEYS_USER_HANDLE_SECRET=AaVBq3A00AODGVNJd9/fzULykRX8/E1Ld0TQhSoTV7E=

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=super@example.com
# Bcrypt hash, never plaintext. Generate with:
# php artisan tinker --execute='echo Hash::make("your-password");'
# Below is the hash for "password" — local dev only, replace in production.
SUPER_ADMIN_PASSWORD_HASH=$2y$12$T69SNPqpkFN98mCF9ICwIuXOBoBqopmJNv2xUdKAfUMBx14fsPGDy

SUPPORT_WHATSAPP=

# Platform subscription billing (PIX that merchants pay their plan to).
# Type: cpf | cnpj | email | phone | random. Empty key = billing QR disabled.
BILLING_PIX_KEY=
BILLING_PIX_KEY_TYPE=random
BILLING_MERCHANT_NAME=
BILLING_LEAD_DAYS=5
BILLING_GRACE_DAYS=7
BILLING_TRIAL_DAYS=7

# Reverb (real-time payment notices). Generate with `php artisan reverb:install`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Server-side publishing target when it differs from the public host above
# (docker: the reverb container). Leave unset to reuse REVERB_HOST/PORT/SCHEME.
# REVERB_INTERNAL_HOST=reverb
# REVERB_INTERNAL_PORT=8080
# REVERB_INTERNAL_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
